FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    HOME=/tmp

RUN pip install --no-cache-dir numpy==2.5.3 \
    && pip install --no-cache-dir torch==2.14.1+cpu --index-url https://download.pytorch.org/whl/cpu

WORKDIR /app
COPY tensorv/__init__.py tensorv/engine.py tensorv/diagnostics.py tensorv/sandbox_worker.py /app/tensorv/
USER 65532:65532
ENTRYPOINT ["python", "-m", "tensorv.sandbox_worker"]
