[Unit]
Description=Remove expired TensorV execution containers
After=docker.service

[Service]
Type=oneshot
User=tensorv
Group=tensorv
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 /opt/tensorv/current/deploy/cleanup-sandboxes.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
